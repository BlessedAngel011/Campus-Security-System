<EmergencyContactsScreen>:
    name: "emergency_contacts"
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: 0.025, 0.176, 0.388, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Button:
                text: "<"
                size_hint_x: None
                width: dp(48)
                background_color: 0, 0, 0, 0
                font_size: "25sp"
                on_release:
                    app.root.transition.direction = "right"
                    app.root.current = "user_dashboard"
            Label:
                text: "Emergency Contacts"
                bold: True
                font_size: "20sp"
            Widget:
                size_hint_x: None
                width: dp(48)
        AppScrollView:
            do_scroll_x: False
            do_scroll_y: True
            scroll_type: ["bars", "content"]
            bar_width: dp(8)
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(12)
                Label:
                    text: "UFH Alice Campus"
                    size_hint_y: None
                    height: dp(42)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "21sp"
                DashboardCard:
                    text: "Campus Security  |  040 602 2243"
                    on_release: root.call_number("0406022243")
                DashboardCard:
                    text: "Campus Security Mobile  |  082 659 6779"
                    on_release: root.call_number("0826596779")
                DashboardCard:
                    text: "Gender-Based Violence  |  072 864 5864"
                    on_release: root.call_number("0728645864")
                Label:
                    text: "National Emergency Services"
                    size_hint_y: None
                    height: dp(42)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "19sp"
                DashboardCard:
                    text: "Mobile Emergency  |  112"
                    on_release: root.call_number("112")
                DashboardCard:
                    text: "Police Flying Squad  |  10111"
                    on_release: root.call_number("10111")
                DashboardCard:
                    text: "Government Ambulance  |  10177"
                    on_release: root.call_number("10177")

                Label:
                    text: "My Emergency Contacts"
                    size_hint_y: None
                    height: dp(45)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "20sp"

                Label:
                    text: "Add people you trust, such as a parent, guardian or friend."
                    size_hint_y: None
                    height: dp(38)
                    color: 0.35, 0.4, 0.48, 1
                    text_size: self.width, None
                    halign: "center"

                FormInput:
                    id: contact_name
                    hint_text: "Contact name"

                FormInput:
                    id: contact_phone
                    hint_text: "Phone number"

                PrimaryButton:
                    text: "Save Emergency Contact"
                    on_release: root.save_personal_contact()

                Label:
                    text: root.status_message
                    size_hint_y: None
                    height: dp(45) if self.text else 0
                    color: (0.1, 0.5, 0.25, 1) if "saved" in self.text or "cleared" in self.text else (0.75, 0.08, 0.14, 1)
                    text_size: self.width, None
                    halign: "center"

                Label:
                    text: root.personal_contacts_text
                    size_hint_y: None
                    height: max(dp(50), self.texture_size[1] + dp(20))
                    color: 0.08, 0.16, 0.25, 1
                    text_size: self.width, None
                    halign: "left"
                    valign: "middle"

                Spinner:
                    id: personal_call_number
                    text: "Select a saved contact"
                    values: root.personal_contact_values
                    size_hint_y: None
                    height: dp(50)

                OutlineButton:
                    text: "Call Personal Contact"
                    on_release: root.call_personal_contact()

                OutlineButton:
                    text: "Clear Personal Contacts"
                    on_release: root.clear_personal_contacts()

                Widget:
                    size_hint_y: None
                    height: dp(25)


