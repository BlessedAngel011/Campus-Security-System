                    color: 0.08, 0.16, 0.25, 1
            BoxLayout:
                size_hint_y: None
                height: dp(52)
                spacing: dp(8)
                FormInput:
                    id: notification_id
                    hint_text: "Notification number"
                    input_filter: "int"
                PrimaryButton:
                    text: "Mark as Read"
                    size_hint_x: 0.45
                    on_release: root.mark_read()


