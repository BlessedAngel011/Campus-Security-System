            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(12)
                Label:
                    text: "UFH Alice Campus"
                    size_hint_y: None
                    height: dp(42)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "21sp"
                DashboardCard:
                    text: "Campus Security  |  040 602 2243"
                    on_release: root.call_number("0406022243")
                DashboardCard:
                    text: "Campus Security Mobile  |  082 659 6779"
                    on_release: root.call_number("0826596779")
                DashboardCard:
                    text: "Gender-Based Violence  |  072 864 5864"
                    on_release: root.call_number("0728645864")
                Label:
                    text: "National Emergency Services"
                    size_hint_y: None
                    height: dp(42)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "19sp"
                DashboardCard:
                    text: "Mobile Emergency  |  112"
                    on_release: root.call_number("112")
                DashboardCard:
                    text: "Police Flying Squad  |  10111"
                    on_release: root.call_number("10111")
                DashboardCard:
                    text: "Government Ambulance  |  10177"
                    on_release: root.call_number("10177")

