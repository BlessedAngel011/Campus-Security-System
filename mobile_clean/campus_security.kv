                    text: "Security Operations"
                    size_hint_y: None
                    height: dp(42)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "20sp"
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                DashboardCard:
                    text: root.active_emergency_count
                    on_release: root.open_feature("Assigned Emergencies")

                DashboardCard:
                    text: "Incident Reports"
                    on_release: root.open_feature("Incident Reports")

                DashboardCard:
                    text: "Notifications"
                    on_release: root.open_feature("Notifications")

                Widget:
                    size_hint_y: None
                    height: dp(16)


<EmergencyScreen>:
    name: "emergency"

    BoxLayout:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: 0.025, 0.176, 0.388, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint_x: None
                width: dp(48)
                background_color: 0, 0, 0, 0
                on_release:
                    app.root.transition.direction = "right"
                    app.root.current = "user_dashboard"

            Label:
                text: "Emergency SOS"
                bold: True
                font_size: "21sp"

            Widget:
                size_hint_x: None
                width: dp(48)

        AppScrollView:
            do_scroll_x: False
            do_scroll_y: True
            scroll_type: ["bars", "content"]
            bar_width: dp(8)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(22)
                spacing: dp(12)

                Label:
                    text: "Send your live location to Campus Security"
                    size_hint_y: None
                    height: dp(52)
                    color: 0.025, 0.176, 0.388, 1
                    bold: True
                    font_size: "19sp"

                Label:
                    text: "Emergency type"
                    size_hint_y: None
                    height: dp(24)
                    color: 0.17, 0.24, 0.34, 1
                    halign: "left"
                    text_size: self.size

                Spinner:
                    id: emergency_type
                    text: "General Emergency"
                    values: ("General Emergency", "Medical Emergency", "Assault", "Fire", "Theft", "Other")
                    size_hint_y: None
                    height: dp(52)

                Label:
                    text: "Description (optional)"
                    size_hint_y: None
                    height: dp(24)
                    color: 0.17, 0.24, 0.34, 1
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: emergency_description
                    hint_text: "Briefly explain what is happening"
                    size_hint_y: None
                    height: dp(105)
                    multiline: True
                    padding: dp(12)

                OutlineButton:
                    text: "Capture My GPS Location"
                    on_release: root.capture_location()

                Label:
                    text: root.location_text
                    size_hint_y: None
                    height: dp(38)
                    color: 0.17, 0.24, 0.34, 1

                EmergencyButton:
                    text: "SEND\nSOS ALERT"
                    disabled: root.loading
                    on_release: root.send_alert()

                Label:
                    text: root.status_message
                    size_hint_y: None
                    height: dp(58) if self.text else 0
                    color: (0.1, 0.5, 0.25, 1) if "success" in self.text.lower() or "captured" in self.text.lower() else (0.75, 0.08, 0.14, 1)
                    text_size: self.width, None
                    halign: "center"


<OfficerAlertsScreen>:
    name: "officer_alerts"
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.94, 0.96, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: 0.025, 0.176, 0.388, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Button:
                text: "<"
                size_hint_x: None
                width: dp(48)
                background_color: 0,0,0,0
                font_size: "25sp"
                on_release:
                    app.root.transition.direction = "right"
                    app.root.current = "officer_dashboard"
            Label:
                text: "Assigned Emergencies"
                bold: True
                font_size: "19sp"
            Button:
                text: "Refresh"
                size_hint_x: None
                width: dp(78)
                background_normal: ""
                background_color: 0.12,0.34,0.60,1
                on_release: root.refresh_alerts()
        AppScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(18)
                spacing: dp(12)
                Label:
                    text: "My Active SOS Assignments"
                    size_hint_y: None
                    height: dp(40)
                    bold: True
                    font_size: "20sp"
                    color: 0.025,0.176,0.388,1
                    halign: "left"
                    text_size: self.size
                Label:
                    text: root.alerts_text
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)
                    text_size: self.width, None
                    halign: "left"
                    color: 0.2,0.28,0.38,1
                BoxLayout:
                    id: emergency_case_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
                Label:
                    id: selected_emergency
                    text: "Select an emergency above to view the person's details."
                    size_hint_y: None
                    height: self.texture_size[1] + dp(32)
                    text_size: self.width - dp(24), None
                    padding: dp(12), dp(12)
                    halign: "left"
                    valign: "middle"
                    color: 0.08,0.16,0.25,1
                    canvas.before:
                        Color:
                            rgba: 1,1,1,1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                PrimaryButton:
                    text: "Accept Emergency"
                    disabled: root.loading
                    on_release: root.accept_emergency()
                PrimaryButton:
                    text: "I Am Responding"
                    disabled: root.loading
                    on_release: root.start_responding()
                OutlineButton:
                    text: "View Latest Location in Maps"
                    on_release: root.open_map()
                Label:
                    text: "Close Emergency"
                    size_hint_y: None
                    height: dp(36)
                    bold: True
                    font_size: "18sp"
                    color: 0.025,0.176,0.388,1
                    halign: "left"
                    text_size: self.size
                Label:
                    text: "Choose whether the SOS was genuine or false, then write the officer review."
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)
                    text_size: self.width, None
                    halign: "left"
                    color: 0.25,0.32,0.42,1
                Spinner:
                    id: emergency_validity
                    text: "Select emergency validity"
                    values: ["GENUINE_EMERGENCY", "FALSE_EMERGENCY"]
                    size_hint_y: None
                    height: dp(58)
                    background_normal: ""
                    background_color: 1,1,1,1
                    color: 0.025,0.176,0.388,1
                TextInput:
                    id: emergency_review
                    hint_text: "Officer review: what happened and how the emergency was concluded..."
                    multiline: True
                    size_hint_y: None
                    height: dp(125)
                    padding: dp(12)
                PrimaryButton:
                    text: "Close Emergency & Save Review"
                    disabled: root.loading
                    on_release: root.resolve_emergency()
                Label:
                    text: root.status_message
                    size_hint_y: None
                    height: self.texture_size[1] + dp(18) if self.text else 0
                    text_size: self.width, None
                    halign: "center"
                    color: (0.1,0.5,0.25,1) if ("selected" in self.text.lower() or "updated" in self.text.lower() or "closed" in self.text.lower()) else (0.75,0.08,0.14,1)
                Widget:
                    size_hint_y: None
                    height: dp(24)

