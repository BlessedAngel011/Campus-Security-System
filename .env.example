SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-personal-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password-with-no-spaces
MAIL_DEFAULT_SENDER=your-personal-email@gmail.com

# Optional: comma-separated addresses for High-priority/SOS alerts.
# If omitted, alerts are sent to MAIL_USERNAME.
SECURITY_ALERT_EMAILS=security@example.com
